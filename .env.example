# turbine-cli reads these from the environment, or from a .env file in the folder you run it in.
# Copy this file to .env and fill in what you need. .env is gitignored: never commit it.

# playground (default, simulated, no real funds) or mainnet.
# Mainnet also needs the --network mainnet flag and a confirmation on every order.
TURBINE_NETWORK=playground

# The wallet that signs your orders. Use a dedicated wallet with a small balance, never your main one.
# Set one of the two: the key itself, or the path to a file holding it (the file must be chmod 600).
TURBINE_PRIVATE_KEY=
TURBINE_KEY_FILE=

# Optional: a mock of the Turbine API on this computer (localhost or 127.0.0.1 only, never on mainnet:
# the API decides which contracts your wallet signs for).
TURBINE_API_URL=
# Optional: your own Ethereum RPC endpoint.
TURBINE_RPC_URL=
