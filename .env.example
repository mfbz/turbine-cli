# Every setting turbine-cli reads. It reads them from your shell's environment only, never from a .env
# in the current folder (a cloned folder must not choose your wallet or endpoints). To use a file you
# trust: set -a; . ./my-settings; set +a

# playground (default, simulated, no real funds) or mainnet.
# Mainnet also needs the --network mainnet flag and a confirmation on every order.
TURBINE_NETWORK=playground

# The wallet that signs: a name from `turbine wallet list` (default: "default"). Wallets are encrypted
# keystores made with `turbine wallet new` or `turbine wallet import`; Foundry keystores work too.
# turbine-cli never reads a raw private key from a variable or a file.
TURBINE_ACCOUNT=

# The wallet password, for scripts and agents. Prefer --password-file <file> (chmod 600).
TURBINE_WALLET_PASSWORD=

# Optional: your own Ethereum RPC endpoint.
TURBINE_RPC_URL=
# Optional: a mock of the Turbine API on this computer only (localhost); never on mainnet.
TURBINE_API_URL=
