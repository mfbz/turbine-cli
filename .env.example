# turbine-cli reads these from the environment, or from a .env file in the folder you run it in.
# Copy this file to .env and fill in what you need. .env is gitignored: never commit it.

# playground (default, simulated, no real funds) or mainnet.
# Mainnet also needs the --network mainnet flag and a confirmation on every order.
TURBINE_NETWORK=playground

# The wallet that signs: a name from `turbine wallet list` (default: "default"). Wallets are encrypted
# keystores made with `turbine wallet new` or `turbine wallet import`; Foundry keystores work too.
# turbine-cli never reads a raw private key from a variable or a file.
TURBINE_ACCOUNT=

# Never put the wallet password here: it is refused in .env. For scripts and agents use
# --password-file <file> (chmod 600), or export TURBINE_WALLET_PASSWORD in your shell.

# Endpoint overrides are never read from .env, because a .env can come with any folder you run turbine in.
# Set them in your shell instead:
#   export TURBINE_RPC_URL=https://your-node.example     (your own Ethereum RPC)
#   export TURBINE_API_URL=http://localhost:3000/api      (a local mock; never on mainnet)
